# CareCircle server
CARECIRCLE_CLOCK=15:10          # pin the household clock for a reproducible demo; use "real" for live time
# CARECIRCLE_DB=data/carecircle.db
# CARECIRCLE_TOKEN=change-me     # require "Authorization: Bearer <token>" on /mcp
# RING_ACCESS_TOKEN=             # Ring Developer Playground token (~30 min) -> live Ring Partner API instead of SAMPLE events
# RING_WEBHOOK_SECRET=           # HMAC key for /ring/webhook (a local demo key is used if unset)
# NTFY_TOPIC=                    # free push to a phone via ntfy.sh (subscribe to the topic in the ntfy app)

# Alexa+ simulator
# CARECIRCLE_URL=http://127.0.0.1:8080
# GROQ_API_KEY=                  # optional LLM planner (free tier); without it a rule planner is used
# LLM_MODEL=openai/gpt-oss-120b
